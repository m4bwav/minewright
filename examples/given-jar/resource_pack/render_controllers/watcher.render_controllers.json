{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.given_jar.watcher": {
      "arrays": {
        "textures": {
          "Array.skin": ["Texture.open", "Texture.closed", "Texture.red"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" },
        { "eye": "Material.eye" },
        { "iris": "Material.eye" }
      ],
      "textures": [
        "Array.skin[query.property('given_jar:eye') == 'red' ? 2 : (query.property('given_jar:eye') == 'closed' ? 1 : 0)]"
      ],
      "part_visibility": [
        { "iris": "query.property('given_jar:eye') != 'closed'" }
      ]
    }
  }
}
